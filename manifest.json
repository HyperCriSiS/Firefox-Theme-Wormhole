{
  "manifest_version": 2,
  "name": "Wormhole",
  "version": "1.3.1",
  "description": "Dark cinematic theme with a seamless wormhole header across all toolbars and a matching new tab page.",
  "homepage_url": "https://github.com/HyperCriSiS/Firefox-Theme-Wormhole",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wormhole-theme@hypercrisis",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "theme",
    "storage",
    "search",
    "tabs",
    "alarms"
  ],
  "optional_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://github.com/*",
    "https://*.githubusercontent.com/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
