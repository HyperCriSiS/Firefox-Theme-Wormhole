{
  "manifest_version": 2,
  "name": "Wormhole",
  "version": "1.5.0",
  "description": "Your own picture, dark or light, running seamlessly across all toolbars and the new tab page. Ready-made sets optional.",
  "homepage_url": "https://github.com/HyperCriSiS/Firefox-Theme-Wormhole",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wormhole-theme@hypercrisis",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "theme",
    "storage",
    "search",
    "alarms"
  ],
  "optional_permissions": [
    "tabs",
    "https://github.com/HyperCriSiS/*",
    "https://*.githubusercontent.com/*"
  ],
  "content_security_policy": "script-src 'self'; object-src 'self'; img-src 'self' data: blob: https://raw.githubusercontent.com",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "gallery.js",
      "background.js"
    ]
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
